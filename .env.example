# m3u8_video_fetcher 服务配置模板
#
# 用法:  cp .env.example .env   然后按需取消注释.
# 加载方: api_server.py (启动时读项目根 .env; scripts/*.sh 仅回显/端口探测).
# 优先级: 环境变量 > .env > 代码默认值.

# --- 监听地址/端口 -----------------------------------------------------------
#HOST=0.0.0.0
#PORT=8000

# --- 服务行为 ----------------------------------------------------------------
# 同时运行的下载任务数 (ThreadPoolExecutor max_workers)
#MAX_CONCURRENT_DOWNLOADS=3
# 单次批量导入 (/api/download/batch) 的任务上限
#BATCH_LIMIT=500
# 任务注册表最大条目数, 超过按 finished_at 驱逐最旧
#MAX_REGISTRY=2000
# 已结束任务保留时间 (秒), 超过由后台清理线程移除
#TASK_TTL_SECONDS=1800

# --- 上传兜底 token ----------------------------------------------------------
# 任务未显式传 upload.token 时使用的兜底 token (如百度网盘 ACCESS_TOKEN)
#ACCESS_TOKEN=
